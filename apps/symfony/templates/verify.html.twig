{% extends 'base.html.twig' %}
{% block content %}
    <div class="page-title">
        <div>
            <div class="eyebrow">
                VÉRIFICATION INDÉPENDANTE
            </div>
            <h1>Contrôler une preuve</h1>
            <p>
                Une empreinte protège l’intégrité d’un contenu, pas la vérité
                d’un fait ni une identité civile.
            </p>
        </div>
    </div>
    <section class="panel">
        <h2>État courant</h2>
        <div class="alert {{ result.valid ? '' : 'error' }}" role="status">
            {{ result.valid ? 'Vérifié' : 'Anomalie' }} — {{ result.reason }}
        </div>
        {% if result.checkpoint is defined %}
            <p>
                <code>{{ result.checkpoint }}</code>
            </p>
        {% endif %}
    </section>
    <section class="panel">
        <h2>Vérifier un export</h2>
        <p>
            Le fichier sera transmis uniquement à cette instance, lu en mémoire
            puis laissé à la suppression automatique du fichier temporaire PHP.
            Il n’est pas ajouté à la base. Pour une vérification entièrement
            hors ligne, utilisez <code>
                php tools/verify-export.php export.json
            </code>.
        </p>
        {{ form_start(form) }}
        {{ form_widget(form) }}
        {{ form_end(form) }}
    </section>
{% endblock %}
