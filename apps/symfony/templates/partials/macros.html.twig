{% macro badge(text, tone = 'gold') %}
    <span class="badge {{ tone }}"><span></span>{{ text }}</span>
{% endmacro %}

{% macro action(type, label, params = {}, class = 'button') %}
    <a class="{{ class }}" href="{{ civic_path('simulation_action', {type: type}|merge(params)) }}">
        {{ label }}
    </a>
{% endmacro %}

{% macro card(proposal, territoryMap) %}
    {% set statuses = {
        draft: 'Brouillon',
        published: 'Chemin publié',
        consultation: 'En consultation',
        experiment: 'En expérimentation',
        result: 'Résultat publié'
    } %}

    <a class="proposal-card" href="{{ civic_path('section', {view: 'proposals', id: proposal.id}) }}">
        <div class="card-top">
            <span class="card-icon" aria-hidden="true">⑂</span>
            {{ _self.badge(statuses[proposal.status] ?? proposal.status, proposal.status == 'experiment' ? 'green' : 'gold') }}
        </div>
        <div class="eyebrow">{{ proposal.theme }} / {{ territoryMap[proposal.territoryId].name }}</div>
        <h3>{{ proposal.title }}</h3>
        <p>{{ proposal.summary }}</p>
        <div class="card-bottom">
            <span>{{ proposal.nodes|length }} éléments · version {{ proposal.version }}</span>
            <span>↗</span>
        </div>
    </a>
{% endmacro %}

{% macro filter(view, state, q, territory) %}
    <div class="filter-bar">
        <form action="{{ civic_path('site_search_submit') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('search') }}">
            <input type="hidden" name="view" value="{{ view }}">
            <input type="hidden" name="territory" value="{{ territory }}">
            <input type="search" maxlength="160" name="q" value="{{ q }}" placeholder="Rechercher un thème, une proposition…" aria-label="Rechercher un thème">
            <button class="button">Filtrer</button>
            <a class="plain" href="{{ civic_path('site_communes') }}">Changer de commune via le sélecteur territorial</a>
        </form>
    </div>
{% endmacro %}
