{% extends 'base.html.twig' %}{% import 'partials/macros.html.twig' as ui %}{% block content %}<div class="page-title"><div><div class="eyebrow">COMPARER LES ATTENTES AUX CONSÉQUENCES</div><h1>Les expériences</h1><p>Protocoles prédéfinis, observations sourcées et droit à la révision.</p></div></div>{{ ui.filter(view,s,q,territory) }}{% for e in s.experiments %}{% if (territory == 'all' or territory == e.territoryId) and (q == '' or q|lower in proposalMap[e.proposalId].title|lower) %}<article class="experiment-card"><div class="row-header">{{ ui.badge(e.status == 'running' ? 'Observation en cours' : 'Bilan disponible','green') }}<span class="small muted">{{ territoryMap[e.territoryId].name }} · {{ e.start }} → {{ e.end }}</span></div><h2>{{ proposalMap[e.proposalId].title }}</h2><p>{{ e.objective }}</p><div class="two-columns"><div><h3>Protocole prédéfini</h3><p><strong>Hypothèse :</strong> {{ e.hypothesis }}</p><p><strong>Indicateur :</strong> {{ e.indicator }}</p><p><strong>Méthode :</strong> {{ e.method }}</p><p><strong>Critère d’arrêt :</strong> {{ e.stop }}</p><p class="muted">{{ e.limitations }}</p></div><div class="observation-chart"><div class="eyebrow">DONNÉES SIMULÉES · {{ e.unit }}</div><div class="metric"><strong>{{ e.observations ? e.observations|last.value : '—' }}</strong><span>valeur observée<br>pour {{ e.baseline }} initialement</span></div>{% for ob in e.observations %}<div class="observation"><div class="row-header"><span>{{ ob.date }}</span><strong>{{ ob.value }} ± {{ ob.uncertainty }}</strong></div><p>Source : {{ ob.source }}<br>Facteur externe : {{ ob.external }}<br>Imprévu : {{ ob.unexpected }}</p></div>{% endfor %}</div></div><div class="action-links">{% if e.status == 'running' %}{{ ui.action('observation.add','Ajouter une observation +',{experimentId:e.id}) }}{{ ui.action('experiment.evaluate','Produire un bilan',{experimentId:e.id}) }}{% endif %}<a class="button" href="{{ path('export',{kind:'experiment',id:e.id}) }}">Exporter le bilan ↓</a><a class="plain" href="{{ path('section',{view:'proposals',id:e.proposalId}) }}">Réexaminer le chemin ↗</a></div>{% if e.evaluation is defined %}<div class="notice"><p>{{ e.evaluation.summary }} · Suite proposée : {{ e.evaluation.decision }}</p></div>{% endif %}</article>{% endif %}{% endfor %}{% endblock %}
