{% extends 'base.html.twig' %}
{% import 'partials/macros.html.twig' as ui %}
{% block content %}
    <div class="page-title">
        <div>
            <div class="eyebrow">
                NE PAS CROIRE, POUVOIR VÉRIFIER
            </div>
            <h1>La transparence</h1>
            <p>
                Registre signé, règles publiques et calculs reproductibles.
            </p>
        </div>
    </div>
    <div class="two-columns">
        <section class="panel">
            <h2>Le registre d’intégrité</h2>
            <p>
                Les opérations sont chaînées en SHA-256, signées en ECDSA P-256
                par PHP/OpenSSL, et associées à une empreinte de l’état courant.
            </p>
            <p class="small muted">
                L’opérateur reste dans le modèle de confiance. Les clés sont
                celles de l’instance, pas des signatures individuelles de
                citoyens. Le premier état pédagogique n’est pas signé.
            </p>
            <div class="row-links">
                <a class="button primary" href="{{ path('verify') }}">
                    Vérifier maintenant →
                </a>
                <a
                    class="button"
                    href="{{
                    path(
                        'export',
                        {
                            kind: 'proofs'
                        }
                    )
                    }}"
                >
                    Exporter les preuves ↓
                </a>
            </div>
        </section>
        <section class="panel">
            <h2>Une anomalie n’est pas une culpabilité</h2>
            <p>
                Un signalement ouvre une vérification ; il ne suspend aucun
                citoyen automatiquement.
            </p>
            {{
                ui.action(
                    'integrity.alert',
                    'Décrire une anomalie',
                    {},
                    'plain'
                )
            }}
            {% for integrityAlert in state.alerts %}
                <p>
                    {{ integrityAlert.reason }} — à vérifier
                </p>
            {% endfor %}
            <hr />
            <p>
                Vérificateur hors ligne : <code>php tools/verify-export.php
                    export.json</code>
            </p>
        </section>
    </div>
    <section class="panel section">
        <h2>Journal des opérations</h2>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Opération</th>
                        <th>Date UTC</th>
                        <th>Empreinte</th>
                    </tr>
                </thead>
                <tbody>
                    {% for auditEvent in state.events|reverse %}
                        <tr>
                            <td>{{ auditEvent.index + 1 }}</td>
                            <td>{{ auditEvent.type }}</td>
                            <td>{{ auditEvent.at }}</td>
                            <td>
                                <code title="{{ auditEvent.hash }}">
                                    {{ auditEvent.hash|slice(0, 24) }}…
                                </code>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                Les opérations enregistrées apparaîtront ici.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    <section class="section">
        <div class="section-heading">
            <h2>Ressources et dépenses</h2>
            {{ ui.action('finance.add', 'Ajouter une écriture fictive +') }}
        </div>
        <div class="panel table-scroll">
            <table class="simple-table">
                <thead>
                    <tr>
                        <th>Libellé fictif</th>
                        <th>Nature</th>
                        <th>Montant</th>
                        <th>Justificatif pédagogique</th>
                    </tr>
                </thead>
                <tbody>
                    {% for financialEntry in state.finance %}
                        <tr>
                            <td>{{ financialEntry.label }}</td>
                            <td>
                                {{ financialEntry.type == 'expense'
                                    ? 'Dépense'
                                    : 'Contribution' }}
                            </td>
                            <td>
                                {{
                                    (financialEntry.cents / 100)|number_format(
                                        2,
                                        ',',
                                        ' '
                                    )
                                }} €
                            </td>
                            <td>{{ financialEntry.receipt }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="small muted">
            Ces chiffres ne représentent pas les coûts réels de l’hébergement.
            Aucun paiement n’est effectué.
        </p>
    </section>
    {% for alert in state.alerts %}
        <section class="panel">
            <h3>Alerte : {{ alert.status }}</h3>
            <p>
                {{ alert.reason }}
            </p>{{
                ui.action(
                    'integrity.review',
                    'Examiner les preuves',
                    {
                        alertId: alert.id
                    }
                )
            }}{% for review in alert.reviews ?? [] %}
                <p>
                    {{ review.at }} · {{ review.to }} · {{ review.proof }}
                </p>
            {% endfor %}
        </section>
    {% endfor %}
{% endblock %}
