{% extends 'base.html.twig' %}
{% block content %}
<div class="page-title"><div>
    <div class="eyebrow">RÉFÉRENTIEL GÉOGRAPHIQUE UNIQUE · INSEE 2026</div>
    <h1>{% if communesDetail %}{{ communesDetail.name }}{% else %}Toutes les communes de France{% endif %}</h1>
    <p>Un répertoire officiel des communes, utilisé dans les fiches, les recherches et le budget. Les informations géographiques ne sont pas des dépenses.</p>
</div></div>
<section class="panel geo-directory">
    <p class="geo-coverage"><strong>Couverture :</strong> {{ communesCoverage.label }} · {{ communesCoverage.count|number_format(0, ',', ' ') }} communes référencées.</p>
    {% include 'partials/geography-search.html.twig' with {geoQuery: communesQuery, geoSearchId: 'directory', geoMode: 'directory'} %}
    {% if communesCoverage.available and not communesCoverage.postals %}
        <p class="budget-gap">Référentiel postal non chargé : la recherche par code postal est indisponible. Lancez l’import La Poste ; les recherches par nom et les codes INSEE explicites restent possibles.</p>
    {% endif %}
    {% if not communesCoverage.available %}
        <p class="budget-gap">L’import INSEE 2026 n’a pas encore été effectué. L’annuaire national et la recherche complète seront disponibles après exécution de l’importateur. Les trois villes pilotes restent accessibles.</p>
    {% endif %}
</section>
{% if communesDetail %}
<section class="panel geo-details">
    <h2>{{ communesDetail.name }} · {{ communesDetail.code }}</h2>
    <dl>
        <div><dt>Code officiel INSEE</dt><dd>{{ communesDetail.code }}</dd></div>
        <div><dt>Département</dt><dd>{{ communesDetail.department }} ({{ communesDetail.departmentCode }})</dd></div>
        <div><dt>Région</dt><dd>{{ communesDetail.region }} ({{ communesDetail.regionCode }})</dd></div>
        <div><dt>Simulation</dt><dd>{{ communesDetail.pilotId ? 'Ville pilote fictive disponible' : 'Pas de scénario fictif pour cette commune' }}</dd></div>
    </dl>
    <div class="geo-actions">
        <form method="post" action="{{ civic_path('territory_choose') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('territory_choose') }}">
            <input type="hidden" name="destination" value="home">
            <input type="hidden" name="code_type" value="insee">
            <input type="hidden" name="code" value="{{ communesDetail.code }}">
            <button class="button primary" type="submit">Choisir cette commune dans tout le site</button>
        </form>
        <a class="button" href="{{ civic_path('section', {view: 'budget', scope: communesDetail.code}) }}#explorateur">Voir ses finances et la traçabilité</a>
        {% if communesDetail.pilotId %}
            <a class="button" href="{{ civic_path('section', {view: 'proposals', territory: communesDetail.pilotId}) }}">Expériences fictives de la ville</a>
        {% endif %}
        <a class="button" href="{{ civic_path('site_communes', {region: communesDetail.regionCode, department: communesDetail.departmentCode}) }}">Autres communes de ce département</a>
    </div>
    <p class="small muted">Une fiche communale n’atteste pas de l’existence de données financières pour l’année choisie. Le budget ne montre que les chiffres effectivement importés et sourcés.</p>
    <p><a href="{{ communesDetail.source }}" rel="noopener noreferrer" target="_blank">Source du Code officiel géographique INSEE 2026</a></p>
</section>
{% else %}
<section class="panel geo-directory">
    <h2>Parcourir les territoires</h2>
    <nav aria-label="Régions"><div class="geo-link-grid">
        {% for region in communesRegions %}
            <a class="geo-link" href="{{ civic_path('site_communes', {region: region.code}) }}">{{ region.name }} <small>{{ region.count }} communes</small></a>
        {% endfor %}
    </div></nav>
    {% if communesRegion != '' %}
        <h3>Départements de la région sélectionnée</h3>
        <div class="geo-link-grid">
            {% for department in communesDepartments %}
                <a class="geo-link" href="{{ civic_path('site_communes', {region: communesRegion, department: department.code}) }}">{{ department.name }} <small>{{ department.count }} communes</small></a>
            {% else %}
                <p>Aucun département connu pour ce code régional.</p>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% if communesQuery != '' or communesDepartment != '' %}
<section class="panel geo-directory" aria-live="polite">
    <h2>{% if communesQuery != '' %}Recherche : {{ communesQuery }}{% else %}Communes du département{% endif %}</h2>
    <p>Choisissez une commune pour ouvrir sa fiche et accéder aux données budgétaires disponibles.</p>
    <div class="geo-result-grid">
        {% for commune in communesResults|slice(0, 40) %}
            <a class="geo-link" href="{{ civic_path('site_commune', {code: commune.code}) }}">
                <strong>{{ commune.name }}</strong> <small>{{ commune.code }}{% if commune.department is defined %} · {{ commune.department }}{% endif %}{% if commune.postalCodes is defined and commune.postalCodes %} · CP {{ commune.postalCodes }}{% endif %}</small>
            </a>
        {% else %}
            <p>Aucun résultat pour ce périmètre. Essayez un nom ou code postal ; pour un identifiant administratif, saisissez INSEE:76351.</p>
        {% endfor %}
    </div>
    <nav aria-label="Pagination des communes" class="geo-actions">
        {% if communesPage > 1 %}
            <a class="button" href="{{ civic_path('site_communes', {q: communesQuery, region: communesRegion, department: communesDepartment, page: communesPage - 1}) }}">Page précédente</a>
        {% endif %}
        <span>Page {{ communesPage }}{% if communesTotal is not null %} · {{ communesTotal }} communes{% endif %}</span>
        {% if communesResults|length > 40 or (communesTotal is not null and communesPage * 40 < communesTotal) %}
            <a class="button" href="{{ civic_path('site_communes', {q: communesQuery, region: communesRegion, department: communesDepartment, page: communesPage + 1}) }}">Page suivante</a>
        {% endif %}
    </nav>
</section>
{% endif %}
{% endif %}
{% endblock %}
