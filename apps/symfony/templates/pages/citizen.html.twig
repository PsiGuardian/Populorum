{% extends 'base.html.twig' %}
{% import 'partials/macros.html.twig' as ui %}
{% block content %}
    {% if selectedCommune is not null and (selectedPilotId is null or selectedPilotId != actor.territoryId) %}
    <section class="notice">
        <h2>Commune consultée et personnage fictif : deux notions différentes</h2>
        <p>Vous consultez {{ selectedCommune.name }}. Le personnage de démonstration reste rattaché à {{ territoryMap[actor.territoryId].name }} ; la sélection géographique ne modifie ni son identité, ni sa famille, ni son droit à participer aux consultations fictives.</p>
        <a class="button" href="{{ civic_path('site_commune', {code:selectedCommune.code}) }}">Fiche de la commune consultée</a>
    </section>
    {% endif %}

    {% if not app.user and not betaProfile %}
        <form method="post" action="{{ civic_path('demo_new_workspace') }}">
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('new_workspace') }}"
            /><button type="submit" class="btn">
                Ouvrir un nouveau laboratoire de 300 personnages fictifs
            </button><p class="muted small">
                L’ancien laboratoire est conservé en base. Le nouveau est isolé
                et contient neuf propositions par ville.
            </p>
        </form>
    {% endif %}
    <div class="page-title">
        <div>
            <div class="eyebrow">
                EXPLORER À SON RYTHME
            </div>
            <h1>Prendre part à l’expérience</h1>
            <p>
                Votre navigateur dispose de sa propre simulation, conservée côté
                serveur dans SQLite. Il ne s’agit pas d’un registre d’identités
                civiles.
            </p>
        </div>
    </div>
    {% if state.mentalSimulation is defined %}
        <section class="panel">
            <h2>Les personnages apprennent et hésitent</h2>
            <p>
                Tour {{ state.mentalSimulation.round }} sur {{
                    state.mentalSimulation.maxRound
                }} : 300 voix narratives, neuf votes locaux par personnage, douze
                réponses par proposition. Les retours sont entièrement inventés.
            </p>{% if not betaProfile %}<a
                class="button"
                href="{{
                civic_path(
                    'fictional_character',
                    {
                        id: actor.id
                    }
                )
                }}"
            >
                Mon portrait, mes raisonnements et leurs versions
            </a>{% endif %}
            {% if
                state.mentalSimulation.round
                    >= state.mentalSimulation.maxRound %}
                <p>
                    Les huit tours sont terminés. Les portraits et leurs
                    historiques restent consultables.
                </p>
            {% elseif (actor.role|default('citizen')) == 'governor' %}
                {{
                    ui.action(
                        'simulation.advance',
                        'Jouer le prochain tour fictif'
                    )
                }}
            {% else %}
                <p class="muted small">
                    Pour jouer le prochain tour, choisissez un personnage de
                    gouvernance fictive, par exemple Personnage Paris 004 (u10).
                    Le tour ne modifie ni les votes clos ni les choix repris
                    manuellement.
                </p>
            {% endif %}
        </section>
    {% endif %}
    <div class="two-columns">
        <section class="panel">
            <h2>Votre personnage actif</h2>
            {% if betaProfile %}
                <p><strong>Compte de test actif :</strong> {{ actor.name }}.</p>
                <p class="small muted">
                    Votre identité de démonstration est reconnue par l'adresse IP et non par
                    une connexion sécurisée. Toute personne utilisant la même adresse
                    peut partager ce compte. Une seule famille électorale de test
                    vous est attribuée, avec un membre et au maximum une voix par
                    nouvelle consultation admissible.
                </p>
                <a class="button" href="{{ civic_path('beta_profile') }}">Gérer mon compte de test</a>
            {% elseif app.user %}
                <p>
                    Compte de laboratoire connecté : {{
                        app.user.userIdentifier
                    }}. Identité de personnage liée au compte.
                </p>
                <form method="post" action="{{ civic_path('citizen_logout') }}">
                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('logout') }}"
                    /><button class="button">Se déconnecter</button>
                </form>
            {% else %}
                <a href="{{ civic_path('citizen_login') }}">
                    Connexion à un laboratoire partagé
                </a>
            {% endif %}
            {% if not app.user and not betaProfile %}
                <form
                    method="post"
                    action="{{ civic_path('persona') }}"
                    class="citizen-select"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('persona') }}"
                    />
                    <label for="citizen">Personnage</label>
                    <select name="citizen" id="citizen">
                        {% for citizen in state.citizens %}
                            <option
                                value="{{ citizen.id }}"
                                {{ citizen.id == actor.id ? 'selected' : '' }}
                            >
                                {{ citizen.name }} — {{
                                    territoryMap[citizen.territoryId].name
                                }}
                            </option>
                        {% endfor %}
                    </select>
                    <button class="button">Choisir</button>
                </form>
            {% endif %}
            <p>
                {{ actor.name }} · {{ territoryMap[actor.territoryId].name }}
            </p>
            <p class="small">
                Rôles fictifs : {{ (actor.roles ?? [actor.role])|join(', ') }}
            </p>
            {{
                ui.badge(
                    actor.consent
                        ? (betaProfile ? 'Publication du nom de test autorisée' : 'Publication nominative fictive consentie')
                        : 'Consentement non donné',
                    actor.consent ? 'green' : 'gray'
                )
            }}
            <div class="action-links">
                {{ ui.action('citizen.preferences', 'Préférences de lecture') }}
                {% if not betaProfile and not app.user %}
                    {{ ui.action('citizen.create', 'Créer un personnage fictif (laboratoire)') }}
                {% endif %}
                {% if not betaProfile %}
                    {{ ui.action('citizen.update', 'Rectifier mon personnage') }}
                {% endif %}
                {% if actor.consent %}
                    {{
                        ui.action(
                            'citizen.withdraw',
                            'Retirer le consentement fictif',
                            {},
                            'plain'
                        )
                    }}
                {% else %}
                    {{
                        ui.action(
                            'citizen.consent',
                            'Définir le consentement fictif'
                        )
                    }}
                {% endif %}
                {% if not betaProfile %}
                    {{
                        ui.action(
                            'citizen.erase',
                            'Effacer le nom fictif',
                            {},
                            'plain danger'
                        )
                    }}
                {% endif %}
                <a
                    class="plain"
                    href="{{
                    civic_path(
                        'export',
                        {
                            kind: 'citizen'
                        }
                    )
                    }}"
                >
                    Exporter le personnage ↓
                </a>
            </div>
        </section>
        <section class="panel">
            <h2>Contribuer au bien commun</h2>
            <p>
                Documentation, traduction, accessibilité, observation ou
                développement : aucune contribution n’achète une voix.
            </p>
            {{
                ui.action(
                    'resource.add',
                    'Décrire une contribution fictive +',
                    {},
                    'button primary'
                )
            }}
            {% for contribution in state.resources %}
                <p>
                    <strong>{{ contribution.kind }}</strong> — {{
                        contribution.description
                    }}
                </p>
            {% endfor %}
            <hr />
            <a class="plain" href="https://github.com/PsiGuardian/Populorum">
                Consulter le dépôt ↗
            </a>
            <p class="small muted">
                L’accès Guardian au profiler est indépendant de ce personnage.
                Son compte public de démonstration ne donne aucun privilège de
                vote.
            </p>
        </section>
    </div>
    {% if betaProfile %}
    <section class="panel section" aria-label="Liste des comptes de test participants">
        <h2>Comptes de test dans le laboratoire partagé</h2>
        <p class="small muted">
            Les noms peuvent être fictifs. Chaque nouveau compte correspond provisoirement
            à une famille d'un membre. Les comptes désactivés ne peuvent plus participer ;
            ils ne sont pas ajoutés aux consultations déjà ouvertes dont les règles sont figées.
        </p>
        <ul>
            {% for citizen in state.citizens %}
                {% if citizen.betaProfile|default(false) and not citizen.suspended|default(false) %}
                    <li>
                        <strong>{{ citizen.name }}</strong>
                        — {{ territoryMap[citizen.territoryId].name }}
                        — 1 membre / 1 famille
                        {% if citizen.id == actor.id %}<strong>(vous)</strong>{% endif %}
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </section>
    {% endif %}
    <section class="panel section">
        <h2>Comprendre les mots</h2>
        <div class="glossary">
            {% for word, meaning in {
                Chemin: 'Un raisonnement autonome : ce que je constate, ce que je suppose et ce que je propose.',
                Quorum: (state.preferences.votingUnit|default('individual'))
                    == 'family'
                    ? 'La part minimale des familles admissibles qui doivent participer.'
                    : 'La part minimale des personnes admissibles qui doivent participer.',
                'Exprimés': (state.preferences.votingUnit|default('individual'))
                    == 'family'
                    ? 'Les familles POUR et CONTRE ; les abstentions familiales participent au quorum, hors exprimés.'
                    : 'Les voix pour et contre ; les abstentions sont comptées à part.',
                Convergence: 'Des chemins se rapprochent librement sans obligation d’accord.',
                Empreinte: 'Un résumé cryptographique qui aide à détecter une modification.',
                'Causalité': 'Un lien de cause à effet à examiner ; une succession ne suffit pas à le démontrer.'
            } %}
                <div>
                    <h4>{{ word }}</h4>
                    <p>
                        {{ meaning }}
                    </p>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
