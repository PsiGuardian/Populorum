{% extends 'base.html.twig' %}
{% import 'partials/macros.html.twig' as ui %}
{% block content %}
    {% if selected != '' and proposalMap[selected] is defined %}
        {% set proposal = proposalMap[selected] %}
        <a
            class="plain back"
            href="{{
            path(
                'section',
                {
                    view: 'proposals'
                }
            )
            }}"
        >
            ← Tous les chemins
        </a>
        <div class="detail-heading">
            {{
                ui.badge(
                    'Version ' ~ proposal.version ~ ' · ' ~ proposal.status
                )
            }}
            <h1>{{ proposal.title }}</h1>
            <p>
                {{ proposal.summary }}
            </p>
            <div class="meta">
                {{ territoryMap[proposal.territoryId].name }} · {{
                    citizenMap[proposal.authorId].name
                }} · Raisonnement autonome
            </div>
        </div>
        <div class="detail-layout">
            <div>
                <div class="causal-summary">
                    {% for key, label in {
                        cause: 'Cause',
                        consequence: 'Conséquence',
                        solution: 'Solution',
                        justification: 'Justification'
                    } %}
                        <div>
                            <div class="eyebrow">
                                {{ label }}
                            </div>
                            <p>
                                {{ proposal[key] }}
                            </p>
                        </div>
                    {% endfor %}
                </div>
                <div class="row-links">
                    {{
                        ui.action(
                            'proposal.transition',
                            'Faire évoluer l’état',
                            {
                                proposalId: proposal.id
                            }
                        )
                    }}
                    {{
                        ui.action(
                            'proposal.reformulate',
                            'Reformuler et expliquer',
                            {
                                proposalId: proposal.id
                            }
                        )
                    }}
                </div>
                <h2>L’arbre du raisonnement</h2>
                <p class="muted small">
                    La liste structurée fournit une lecture accessible des
                    catégories et de leurs compléments. Une observation simulée
                    ne démontre pas une causalité.
                </p>
                {% if graph is defined %}
                    <details class="panel">
                        <summary>
                            Afficher le graphe des relations déclarées
                        </summary>
                        <div
                            class="causal-graph-scroll"
                            tabindex="0"
                            role="region"
                            aria-label="Graphe causal ; liste et relations textuelles disponibles à la suite"
                        >
                            <svg
                                viewBox="0 0 920 {{ graph.height }}"
                                role="img"
                                aria-labelledby="graph-title"
                            >
                                <title id="graph-title">
                                    Relations déclarées dans {{
                                        proposal.title
                                    }}. La disposition n’est pas une preuve de
                                    causalité.
                                </title>
                                <defs>
                                    <marker
                                        id="arrow"
                                        markerWidth="8"
                                        markerHeight="8"
                                        refX="7"
                                        refY="4"
                                        orient="auto"
                                    >
                                        <path
                                            d="M0 0L8 4L0 8Z"
                                            fill="#80632c"
                                        />
                                    </marker>
                                </defs>
                                {% for edge in graph.edges %}
                                    <g>
                                        <title>
                                            {{ edge.from }} : {{
                                                edge.relation
                                            }} : {{ edge.to }}
                                        </title>
                                        <line
                                            x1="{{ edge.x1 }}"
                                            y1="{{ edge.y1 }}"
                                            x2="{{ edge.x2 }}"
                                            y2="{{ edge.y2 }}"
                                            stroke="#80632c"
                                            stroke-width="2"
                                            marker-end="url(#arrow)"
                                        />
                                    </g>
                                {% endfor %}
                                {% for node in graph.nodes %}
                                    <a href="#causal-{{ node.id }}">
                                        <title>
                                            {{ node.category }} : {{
                                                node.content
                                            }}
                                        </title>
                                        <rect
                                            x="{{ node.x }}"
                                            y="{{ node.y }}"
                                            width="260"
                                            height="70"
                                            rx="8"
                                            fill="#f2eee5"
                                            stroke="#80632c"
                                        />
                                        <text
                                            x="{{ node.x + 12 }}"
                                            y="{{ node.y + 30 }}"
                                            font-size="12"
                                            fill="#111d2b"
                                        >
                                            {{ node.category|slice(0, 34) }}
                                        </text>
                                        <text
                                            x="{{ node.x + 12 }}"
                                            y="{{ node.y + 50 }}"
                                            font-size="11"
                                            fill="#111d2b"
                                        >
                                            {{ (node.evidenceType|default(''))
                                                == 'public_document'
                                                ? 'Document public cité'
                                                : (node.evidenceType|default(
                                                    ''
                                                ))
                                                    == 'media_context'
                                                    ? 'Contexte médiatique cité'
                                                    : node.kind == 'observation'
                                                        ? 'Observation simulée'
                                                        : 'Hypothèse' }}
                                        </text>
                                    </a>
                                {% endfor %}
                            </svg>
                        </div>
                    </details>
                {% endif %}
                <div class="causal-grid">
                    {% for node in proposal.nodes %}
                        <article
                            id="causal-{{ node.id }}"
                            class="causal-node {{
                            node.kind == 'observation'
                                ? 'observed'
                                : ''
                            }}"
                        >
                            <div>
                                <div class="eyebrow">
                                    {{ '%02d'|format(loop.index) }} · {{
                                        node.category
                                    }}
                                </div>
                                <p>
                                    {{ node.content }}
                                </p>
                                <small>
                                    {{ (node.evidenceType|default(''))
                                        == 'public_document'
                                        ? 'Document public cité — interprétation à discuter'
                                        : (node.evidenceType|default(''))
                                            == 'media_context'
                                            ? 'Contexte médiatique cité — ne mesure pas la délinquance'
                                            : node.kind == 'observation'
                                                ? 'Observation simulée'
                                                : 'Hypothèse / prévision' }}
                                </small>
                            </div>
                        </article>
                    {% endfor %}
                </div>
                <div class="row-links">
                    {{
                        ui.action(
                            'proposal.node',
                            'Ajouter un élément',
                            {
                                proposalId: proposal.id
                            }
                        )
                    }}
                    {{
                        ui.action(
                            'proposal.edge',
                            'Relier deux éléments',
                            {
                                proposalId: proposal.id
                            }
                        )
                    }}
                </div>
                <details class="panel">
                    <summary>
                        Relations explicites
                    </summary>
                    {% set nodeMap = {} %}
                    {% for node in proposal.nodes %}
                        {% set nodeMap =
                            nodeMap|merge({
                                (node.id): node.category
                            })
                        %}
                    {% endfor %}
                    {% for edge in proposal.edges %}
                        <p>
                            {{ nodeMap[edge.from] ?? edge.from }} → {{
                                edge.relation
                            }} → {{ nodeMap[edge.to] ?? edge.to }}
                        </p>
                    {% else %}
                        <p>
                            Les relations entre éléments seront complétées ;
                            leur simple succession ne prouve pas un lien causal.
                        </p>
                    {% endfor %}
                </details>
                <section class="panel">
                    <h3>Sources et limites</h3>
                    {{
                        ui.action(
                            'proposal.source',
                            'Ajouter une source',
                            {
                                proposalId: proposal.id
                            }
                        )
                    }}
                    {% for source in proposal.sources %}
                        <p>
                            {% if
                                source.url starts with 'https://'
                                    or source.url starts with 'http://' %}
                                <a
                                    href="{{ source.url }}"
                                    rel="noopener noreferrer"
                                >
                                    {{ source.label }}
                                </a>
                            {% else %}
                                {{ source.label }}
                            {% endif %}· {{ source.date }}
                        </p>
                    {% endfor %}
                    <p>
                        Jeu pédagogique : aucun résultat simulé n’est présenté
                        comme un fait réel sur la ville.
                    </p>
                </section>
                {% for reformulation in proposal.reformulations ?? [] %}
                    <section
                        class="panel"
                        lang="{{ reformulation.locale|slice(0, 2) }}"
                    >
                        <h3>
                            {{ reformulation.level }} · version {{
                                reformulation.referenceVersion
                            }}
                        </h3>
                        <p>
                            {{ reformulation.text }}
                        </p>
                        <p>
                            <strong>Glossaire :</strong>
                            {{ reformulation.glossary }}
                        </p>
                        <p class="small muted">
                            {{ reformulation.warning }}
                        </p>
                    </section>
                {% endfor %}
                {% for transition in proposal.transitions ?? [] %}
                    <p class="small">
                        {{ transition.at }} : {{ transition.from }} → {{
                            transition.to
                        }} · {{ transition.reason }}
                    </p>
                {% endfor %}
                <section class="panel">
                    <h3>Versions du chemin</h3>
                    {% for revision in proposal.revisions %}
                        <details>
                            <summary>
                                Version {{ revision.version }} · {{ revision.reason }}
                            </summary>
                            {% for key, label in {
                                title: 'Titre',
                                problem: 'Problème',
                                summary: 'Explication',
                                cause: 'Cause',
                                consequence: 'Conséquence',
                                solution: 'Solution',
                                justification: 'Justification',
                                indicator: 'Indicateur',
                                forecast: 'Prévision',
                                risk: 'Risques',
                                reversibility: 'Retour arrière'
                            } %}
                                <h4>{{ label }}</h4>
                                <p>
                                    {{ revision.snapshot[key] }}
                                </p>
                            {% endfor %}
                            {% for node in revision.snapshot.nodes %}
                                <p>
                                    <strong>{{ node.category }}</strong> : {{
                                        node.content
                                    }}
                                </p>
                            {% endfor %}
                            {% for source in revision.snapshot.sources %}
                                <p>
                                    Source :{% if
                                        source.url starts with 'https://'
                                            or source.url
                                                starts with 'http://' %}
                                        <a
                                            href="{{ source.url }}"
                                            rel="noopener noreferrer"
                                        >
                                            {{ source.label }}
                                        </a>
                                    {% else %}
                                        {{ source.label }}
                                    {% endif %}· {{ source.date }}
                                </p>
                            {% endfor %}
                            {% for edge in revision.snapshot.edges %}
                                <p>
                                    {{ edge.from }} → {{ edge.relation }} → {{
                                        edge.to
                                    }}
                                </p>
                            {% endfor %}
                        </details>
                    {% else %}
                        <p>
                            Première version. Toute révision significative
                            conservera un motif et une trace.
                        </p>
                    {% endfor %}
                </section>
            </div>
            <aside class="detail-aside">
                <section class="panel">
                    <div class="eyebrow">
                        EXPÉRIMENTER AVEC PRUDENCE
                    </div>
                    <h3>{{ proposal.indicator }}</h3>
                    <h4>Risques anticipés</h4>
                    <p>
                        {{ proposal.risk }}
                    </p>
                    <h4>Retour arrière</h4>
                    <p>
                        {{ proposal.reversibility }}
                    </p>
                    {{
                        ui.action(
                            'proposal.revise',
                            'Faire évoluer ce chemin',
                            {
                                proposalId: proposal.id
                            },
                            'button full'
                        )
                    }}
                    {% if proposal.status == 'draft' %}
                        {{
                            ui.action(
                                'proposal.publish',
                                'Publier le brouillon',
                                {
                                    proposalId: proposal.id
                                },
                                'button full'
                            )
                        }}
                    {% endif %}
                    {% set open =
                        state.consultations|filter(
                            consultation => consultation.proposalId
                                == proposal.id
                                and consultation.status == 'open'
                        )
                    %}
                    {% if open %}
                        <a
                            class="button primary full"
                            href="{{
                            path(
                                'section',
                                {
                                    view: 'consultations',
                                    id: open|first.id
                                }
                            )
                            }}"
                        >
                            Voir la consultation →
                        </a>
                    {% else %}
                        {{
                            ui.action(
                                'consultation.open',
                                'Ouvrir une consultation',
                                {
                                    proposalId: proposal.id
                                },
                                'button primary full'
                            )
                        }}
                    {% endif %}
                </section>
                <section class="panel">
                    <h3>Un autre contexte ?</h3>
                    <p>
                        Aucune application automatique dans une autre ville.
                    </p>
                    {{
                        ui.action(
                            'territory.adapt',
                            'Adapter ou documenter une exclusion',
                            {
                                proposalId: proposal.id
                            },
                            'plain'
                        )
                    }}
                </section>
            </aside>
        </div>
    {% else %}
        <div class="page-title">
            <div>
                <div class="eyebrow">
                    DES RAISONNEMENTS AUTONOMES
                </div>
                <h1>Explorer les chemins</h1>
                <p>
                    Exposer un raisonnement, documenter les causes et rendre
                    visibles les conséquences.
                </p>
            </div>
            {{
                ui.action(
                    'proposal.create',
                    'Exposer mon chemin +',
                    {},
                    'button primary'
                )
            }}
        </div>
        {{ ui.filter(view, state, q, territory) }}
        <div class="cards-grid">
            {% set found = 0 %}
            <p class="muted small">
                Ordre éditorial explicite du jeu de démonstration : sécurité et
                prévention d’abord, puis autres services, titres par ordre
                alphabétique. Ce classement ne représente aucune préférence des
                habitants. Propositions expérimentales sans effet juridique.
            </p>
            {% for proposal in proposalList %}
                {% if
                    (territory == 'all' or territory == proposal.territoryId)
                        and (q == ''
                            or (q|lower)
                            in ((proposal.title ~ proposal.summary
                            ~ proposal.theme)|lower)) %}
                    {{ ui.card(proposal, territoryMap) }}
                    {% set found = found + 1 %}
                {% endif %}
            {% endfor %}
            {% if not found %}
                <p class="empty">
                    Aucun chemin ne correspond à ces critères.
                </p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
