{% extends 'pages/policy-shell.html.twig' %}

{% block policy_title %}Voter sur une proposition de loi · Populorum{% endblock %}

{% block policy_content %}
    <p class="small muted">
        <a href="{{ path(backRoute) }}">← Revenir aux
            {{ policySection == 'consultations' ? 'consultations' : 'propositions de loi' }}
        </a>
    </p>
    <section class="policy-hero">
        <div class="eyebrow">DOSSIER PARLEMENTAIRE · VOTE EXPÉRIMENTAL</div>
        <div class="policy-tags">
            <span class="policy-tag">{{ measure.category }}</span>
            <span class="policy-tag">France entière</span>
            <span class="policy-tag {{ measure.closed ? 'closed' : 'open' }}">
                {{ measure.closed ? 'Consultation clôturée' : 'Consultation ouverte' }}
            </span>
        </div>
        <h1>{{ measure.label }}</h1>
        <p>Question soumise : <strong>Êtes-vous favorable au principe exprimé
            par cette proposition de loi ?</strong></p>
        <p class="small muted">Le dossier a été officiellement déposé au Sénat.
            Son intitulé ne reproduit pas les articles du texte et ne prouve pas
            que celui-ci a été adopté ni qu'il est applicable tel quel.</p>
    </section>

    <section class="policy-panel" aria-labelledby="causes-and-effects">
        <h2 id="causes-and-effects">Avant de voter : causes, effets et limites</h2>
        <p>Pour vous forger une opinion, examinez le problème visé par le texte,
            les bénéficiaires potentiels, les contraintes budgétaires et juridiques,
            les alternatives et les conséquences imprévues.</p>
        <ul>
            <li>Quels faits vérifiables justifient cette proposition ?</li>
            <li>Quels changements pourrait-elle introduire dans la vie quotidienne ?</li>
            <li>Quels coûts, risques et effets indirects faudrait-il mesurer ?</li>
            <li>Quelles données permettraient de vérifier les résultats après application ?</li>
        </ul>
        <p class="small muted">
            Populorum ne prétend pas avoir calculé les coûts ou les bénéfices de
            chaque texte. Il s'agit de questions d'examen, pas de conséquences
            établies scientifiquement.
        </p>
    </section>

    {% if measure.closed %}
        <section class="policy-panel" aria-labelledby="results-heading">
            <h2 id="results-heading">Consultation clôturée : résultat de simulation</h2>
            <div class="policy-score">
                <div><strong>{{ measure.tally.pour }}</strong>Pour :</div>
                <div><strong>{{ measure.tally.contre }}</strong>Contre :</div>
                <div><strong>{{ measure.tally.abstention }}</strong>Abstention :</div>
            </div>
            <p class="small muted">Chaque compte de test constitue provisoirement
                une famille d'un membre. Ces chiffres n'ont pas de valeur
                statistique représentative et ne sont pas des résultats électoraux.</p>
        </section>
        <section class="policy-panel" aria-labelledby="origin-heading">
            <h2 id="origin-heading">Provenance et dossier historique</h2>
            <p><strong>Origine :</strong> {{ measure.originActor }}</p>
            <p><strong>Nature :</strong> {{ measure.sourceType }}</p>
            <p><strong>Date de dépôt :</strong> {{ measure.sourceDate }}</p>
            <p><strong>État à la date de l'import :</strong> {{ measure.legalStatus }}</p>
            <p><strong>Référence officielle :</strong> {{ measure.sourceReference }}</p>
            <p><a class="policy-link" href="{{ measure.sourceUrl }}"
                  rel="noopener noreferrer" target="_blank">
                Consulter le dossier officiel du Sénat ↗
            </a></p>
            <p class="small muted">Le dossier peut avoir évolué depuis l'importation.
                Son état actuel doit être vérifié sur le site parlementaire.</p>
        </section>
    {% elseif not profile %}
        <section class="policy-panel">
            <h2>Créer un compte de test pour participer</h2>
            <p>Vous pouvez lire les propositions sans compte. Pour enregistrer
                un avis, un profil expérimental est nécessaire ; son identité
                repose sur l'adresse IP, sans vérification d'état civil.</p>
            <a class="policy-link primary" href="{{ path('beta_profile') }}">
                Accéder au compte de test
            </a>
        </section>
    {% elseif not eligible %}
        <section class="policy-panel">
            <h2>Participation non disponible dans ce territoire</h2>
            <p>Ce texte ne correspond pas au périmètre territorial de votre profil
                de test. Vous pouvez l'examiner sans voter sur cette consultation.</p>
        </section>
    {% else %}
        <section class="policy-panel" aria-labelledby="vote-form-heading">
            <h2 id="vote-form-heading">Exprimer votre position</h2>
            {% if saved %}
                <p class="policy-tag voted" role="status">Position enregistrée.</p>
            {% endif %}
            <p>Une seule position active par compte de test et par texte.
                Elle peut être modifiée jusqu'à la clôture ; chaque modification
                reste historisée. Aucune obligation de participation.</p>
            {% if existingVote %}
                <p class="policy-tag voted">Votre dernière position :
                    <strong>{{ existingVote|upper }}</strong>
                </p>
            {% endif %}
            <form method="post" class="policy-vote-form"
                  action="{{ path('policy_vote', {id: measure.id}) }}">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="_from" value="{{ policySection }}">
                <fieldset>
                    <legend>Votre choix</legend>
                    <div class="policy-vote-options">
                        {% for value, label in {pour:'Pour', contre:'Contre', abstention:'Abstention'} %}
                            <label>
                                <input type="radio" name="choice" value="{{ value }}"
                                       {{ existingVote == value ? 'checked' : '' }} required>
                                {{ label }}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <p class="small muted">Les prises de position et les délibérations
                    sont séparées : pour expliquer votre choix, utilisez ensuite
                    l’arbre des causes et conséquences. Aucun commentaire libre
                    n’est enregistré dans le bulletin.</p>
                <button type="submit">Enregistrer ma position fictive</button>
            </form>
        </section>
    {% endif %}

    <section class="policy-panel policy-deliberation" id="arbre-causal"
             aria-labelledby="deliberation-title">
        <div class="eyebrow">APRÈS LE VOTE · DÉLIBÉRATION STRUCTURÉE</div>
        <h2 id="deliberation-title">L’arbre des causes et conséquences</h2>
        <p>
            Une proposition de loi peut susciter plusieurs raisonnements contradictoires.
            Dans cet espace, on ne publie pas de message libre : chaque contribution
            doit exposer <strong>une cause ET une conséquence</strong>,
            distinguer une hypothèse d’un fait observé ou présenté comme démontré,
            et citer une source lorsque c’est possible.
        </p>
        <div class="policy-causal-principle" aria-label="Structure obligatoire d’une contribution">
            <div>Cause identifiée <small>Probable · observée · documentée</small></div>
            <span aria-hidden="true">→</span>
            <div>Proposition de loi <small>Texte parlementaire officiel</small></div>
            <span aria-hidden="true">→</span>
            <div>Conséquence envisagée <small>Probable · observée · documentée</small></div>
        </div>
        <p class="small muted">
            Une URL citée ne constitue pas à elle seule une démonstration :
            la fiabilité de la source et le lien causal restent à examiner.
            Les contributions sont des analyses de participants, jamais des faits
            certifiés par Populorum. L’arbre ne modifie pas le résultat du scrutin.
        </p>

        {% if not deliberationVisible %}
            <div class="policy-empty">
                <h3>La délibération s’ouvre après votre vote</h3>
                <p>Exprimez d’abord Pour, Contre ou Abstention sur cette proposition.
                    L’arbre devient alors consultable et vous pouvez y ajouter
                    une cause et une conséquence. Après clôture du scrutin,
                    le raisonnement collectif devient consultable par tous.</p>
                {% if not profile %}
                    <a class="policy-link primary" href="{{ path('beta_profile') }}">
                        Créer un compte de test
                    </a>
                {% endif %}
            </div>
        {% else %}
            {% if contributed %}
                <p class="policy-tag voted" role="status">Votre analyse causale a été publiée.</p>
            {% endif %}
            <div class="policy-results-title">
                <h3>{{ causalTree.total }} contribution(s) structurée(s)</h3>
                <p>Branche initiale ou réponse à une analyse précédente</p>
            </div>
            {% set degrees = {
                probable: 'Probable · hypothèse à tester',
                observee: 'Observée · à corroborer',
                demontree: 'Présentée comme démontrée · source à vérifier'
            } %}
            <div class="policy-causal-branches">
                {% for node in causalTree.rows %}
                    <article class="policy-causal-branch"
                             id="deliberation-{{ node.id }}"
                             style="--causal-depth: {{ node.depth }}">
                        <header class="policy-causal-header">
                            <div class="policy-tags">
                                <span class="policy-tag">Branche {{ node.depth + 1 }}</span>
                                <span class="policy-tag">{{ node.participant_label }}</span>
                                <span class="policy-tag">
                                    {{ node.created_at|date('d/m/Y · H:i', 'UTC') }} UTC
                                </span>
                            </div>
                            {% if node.parent_id %}
                                <p class="small muted">
                                    Réponse à une cause précédente :
                                    « {{ node.parent_cause|slice(0, 135) }}{{ node.parent_cause|length > 135 ? '…' : '' }} »
                                </p>
                            {% endif %}
                        </header>
                        <div class="policy-causal-pair">
                            <div class="policy-causal-fact">
                                <h4>Cause avancée</h4>
                                <span class="policy-tag">{{ degrees[node.cause_degree] }}</span>
                                <p>{{ node.cause_text|nl2br }}</p>
                                {% if node.cause_source %}
                                    <a href="{{ node.cause_source }}" target="_blank"
                                       rel="nofollow noopener noreferrer">
                                        Examiner la source de la cause ↗
                                    </a>
                                {% else %}
                                    <small>Sans source externe fournie</small>
                                {% endif %}
                            </div>
                            <span class="policy-causal-arrow" aria-hidden="true">→</span>
                            <div class="policy-causal-fact">
                                <h4>Conséquence envisagée</h4>
                                <span class="policy-tag">{{ degrees[node.consequence_degree] }}</span>
                                <p>{{ node.consequence_text|nl2br }}</p>
                                {% if node.consequence_source %}
                                    <a href="{{ node.consequence_source }}" target="_blank"
                                       rel="nofollow noopener noreferrer">
                                        Examiner la source de la conséquence ↗
                                    </a>
                                {% else %}
                                    <small>Sans source externe fournie</small>
                                {% endif %}
                            </div>
                        </div>
                        {% if canDeliberate and node.depth < 6 %}
                            <p class="policy-causal-actions">
                                <a class="policy-link" href="{{ path('policy_detail', {
                                    id: measure.id, from: policySection,
                                    reply: node.id
                                }) }}#deliberation-form">
                                    Ajouter une branche en réponse
                                </a>
                            </p>
                        {% endif %}
                    </article>
                {% else %}
                    <div class="policy-empty">
                        <h3>La première branche reste à écrire</h3>
                        <p>Proposez une cause, une conséquence et leur degré de preuve.
                            Les contributions suivantes pourront développer,
                            contester ou compléter ce raisonnement.</p>
                    </div>
                {% endfor %}
            </div>

            {% if causalTree.pages > 1 %}
                <nav class="policy-pagination" aria-label="Pagination des branches causales">
                    {% if causalTree.page > 1 %}
                        <a class="policy-link" href="{{ path('policy_detail', {
                            id: measure.id, from: policySection,
                            treePage: causalTree.page - 1
                        }) }}#arbre-causal">← Analyses précédentes</a>
                    {% endif %}
                    <span>Page {{ causalTree.page }} sur {{ causalTree.pages }}</span>
                    {% if causalTree.page < causalTree.pages %}
                        <a class="policy-link" href="{{ path('policy_detail', {
                            id: measure.id, from: policySection,
                            treePage: causalTree.page + 1
                        }) }}#arbre-causal">Analyses suivantes →</a>
                    {% endif %}
                </nav>
            {% endif %}

            {% if canDeliberate %}
                <form id="deliberation-form" class="policy-causal-form"
                      method="post"
                      action="{{ path('policy_deliberation_add', {id: measure.id}) }}">
                    <h3>Apporter un raisonnement causal</h3>
                    <p class="small muted">Chaque publication est conservée comme
                        une nouvelle branche. Pour corriger votre position, publiez
                        une branche complémentaire explicitant les faits nouveaux.</p>
                    {% if reply %}
                        <div class="policy-causal-reply">
                            Vous répondez à une analyse de {{ reply.participant_label }} :
                            « {{ reply.cause_text|slice(0, 135) }}… »
                            <a href="{{ path('policy_detail', {
                                id: measure.id, from: policySection
                            }) }}#deliberation-form">Créer une branche indépendante</a>
                        </div>
                    {% endif %}
                    <input type="hidden" name="_token" value="{{ deliberationToken }}">
                    <input type="hidden" name="_from" value="{{ policySection }}">
                    <input type="hidden" name="parent_id" value="{{ reply ? reply.id : '' }}">
                    <div class="policy-causal-form-grid">
                        <fieldset>
                            <legend>1. Cause obligatoire</legend>
                            <label for="causal-cause-text">Quelle cause avancez-vous ?</label>
                            <textarea id="causal-cause-text" name="cause_text"
                                      minlength="25" maxlength="1500" rows="5"
                                      required placeholder="Décrivez un mécanisme causal concret, avec ses limites."></textarea>
                            <label for="causal-cause-degree">Degré de preuve</label>
                            <select id="causal-cause-degree" name="cause_degree" required>
                                <option value="probable">Probable · hypothèse</option>
                                <option value="observee">Observée · à corroborer</option>
                                <option value="demontree">Présentée comme démontrée · source obligatoire</option>
                            </select>
                            <label for="causal-cause-source">Source HTTPS (si possible)</label>
                            <input id="causal-cause-source" type="url" name="cause_source"
                                   maxlength="500" placeholder="https://...">
                        </fieldset>
                        <fieldset>
                            <legend>2. Conséquence obligatoire</legend>
                            <label for="causal-consequence-text">Quelle conséquence en découlerait ?</label>
                            <textarea id="causal-consequence-text" name="consequence_text"
                                      minlength="25" maxlength="1500" rows="5"
                                      required placeholder="Décrivez un effet favorable, défavorable ou indirect testable."></textarea>
                            <label for="causal-consequence-degree">Degré de preuve</label>
                            <select id="causal-consequence-degree" name="consequence_degree" required>
                                <option value="probable">Probable · hypothèse</option>
                                <option value="observee">Observée · à corroborer</option>
                                <option value="demontree">Présentée comme démontrée · source obligatoire</option>
                            </select>
                            <label for="causal-consequence-source">Source HTTPS (si possible)</label>
                            <input id="causal-consequence-source" type="url"
                                   name="consequence_source" maxlength="500"
                                   placeholder="https://...">
                        </fieldset>
                    </div>
                    <p class="small muted">Les contributions sont publiques après votre vote,
                        et après clôture elles sont consultables même sans compte.
                        Seul un identifiant pseudonyme du profil de test est affiché.
                        Pas de discussion libre ni de données personnelles.</p>
                    <button type="submit">Publier la cause et la conséquence</button>
                </form>
            {% else %}
                <p class="policy-disclaimer">Pour ajouter une branche,
                    vous devez avoir exprimé un vote sur ce texte à l’aide
                    d’un compte de test encore actif. Les consultations closes
                    conservent l’accès à l’arbre pour les anciens votants.</p>
            {% endif %}
        {% endif %}
    </section>

    <aside class="policy-disclaimer">
        <strong>Échéance de la consultation expérimentale</strong>
        <p>Clôture programmée : {{ measure.closesAt|date('d/m/Y à H:i', 'UTC') }}
            (heure UTC). Les résultats agrégés et la provenance du dossier
            deviennent publics après clôture uniquement.
            Ce bulletin ne modifie aucune loi ni consultation historique.</p>
    </aside>
{% endblock %}
