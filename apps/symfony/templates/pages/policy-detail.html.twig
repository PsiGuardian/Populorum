{% extends 'pages/policy-shell.html.twig' %}

{% block policy_title %}Voter sur une proposition de loi · Populorum{% endblock %}

{% block policy_content %}
    <p class="small muted">
        <a href="{{ path(backRoute) }}">← Revenir aux
            {{ policySection == 'consultations' ? 'consultations' : 'propositions de loi' }}
        </a>
    </p>
    <section class="policy-hero">
        <div class="eyebrow">DOSSIER PARLEMENTAIRE · VOTE EXPÉRIMENTAL</div>
        <div class="policy-tags">
            <span class="policy-tag">{{ measure.category }}</span>
            <span class="policy-tag">France entière</span>
            <span class="policy-tag {{ measure.closed ? 'closed' : 'open' }}">
                {{ measure.closed ? 'Consultation clôturée' : 'Consultation ouverte' }}
            </span>
        </div>
        <h1>{{ measure.label }}</h1>
        <p>Question soumise : <strong>Êtes-vous favorable au principe exprimé
            par cette proposition de loi ?</strong></p>
        <p class="small muted">Le dossier a été officiellement déposé au Sénat.
            Son intitulé ne reproduit pas les articles du texte et ne prouve pas
            que celui-ci a été adopté ni qu'il est applicable tel quel.</p>
    </section>

    <section class="policy-panel" aria-labelledby="causes-and-effects">
        <h2 id="causes-and-effects">Avant de voter : causes, effets et limites</h2>
        <p>Pour vous forger une opinion, examinez le problème visé par le texte,
            les bénéficiaires potentiels, les contraintes budgétaires et juridiques,
            les alternatives et les conséquences imprévues.</p>
        <ul>
            <li>Quels faits vérifiables justifient cette proposition ?</li>
            <li>Quels changements pourrait-elle introduire dans la vie quotidienne ?</li>
            <li>Quels coûts, risques et effets indirects faudrait-il mesurer ?</li>
            <li>Quelles données permettraient de vérifier les résultats après application ?</li>
        </ul>
        <p class="small muted">
            Populorum ne prétend pas avoir calculé les coûts ou les bénéfices de
            chaque texte. Il s'agit de questions d'examen, pas de conséquences
            établies scientifiquement.
        </p>
    </section>

    {% if measure.closed %}
        <section class="policy-panel" aria-labelledby="results-heading">
            <h2 id="results-heading">Consultation clôturée : résultat de simulation</h2>
            <div class="policy-score">
                <div><strong>{{ measure.tally.pour }}</strong>Pour :</div>
                <div><strong>{{ measure.tally.contre }}</strong>Contre :</div>
                <div><strong>{{ measure.tally.abstention }}</strong>Abstention :</div>
            </div>
            <p class="small muted">Chaque compte de test constitue provisoirement
                une famille d'un membre. Ces chiffres n'ont pas de valeur
                statistique représentative et ne sont pas des résultats électoraux.</p>
        </section>
        <section class="policy-panel" aria-labelledby="origin-heading">
            <h2 id="origin-heading">Provenance et dossier historique</h2>
            <p><strong>Origine :</strong> {{ measure.originActor }}</p>
            <p><strong>Nature :</strong> {{ measure.sourceType }}</p>
            <p><strong>Date de dépôt :</strong> {{ measure.sourceDate }}</p>
            <p><strong>État à la date de l'import :</strong> {{ measure.legalStatus }}</p>
            <p><strong>Référence officielle :</strong> {{ measure.sourceReference }}</p>
            <p><a class="policy-link" href="{{ measure.sourceUrl }}"
                  rel="noopener noreferrer" target="_blank">
                Consulter le dossier officiel du Sénat ↗
            </a></p>
            <p class="small muted">Le dossier peut avoir évolué depuis l'importation.
                Son état actuel doit être vérifié sur le site parlementaire.</p>
        </section>
    {% elseif not profile %}
        <section class="policy-panel">
            <h2>Créer un compte de test pour participer</h2>
            <p>Vous pouvez lire les propositions sans compte. Pour enregistrer
                un avis, un profil expérimental est nécessaire ; son identité
                repose sur l'adresse IP, sans vérification d'état civil.</p>
            <a class="policy-link primary" href="{{ path('beta_profile') }}">
                Accéder au compte de test
            </a>
        </section>
    {% elseif not eligible %}
        <section class="policy-panel">
            <h2>Participation non disponible dans ce territoire</h2>
            <p>Ce texte ne correspond pas au périmètre territorial de votre profil
                de test. Vous pouvez l'examiner sans voter sur cette consultation.</p>
        </section>
    {% else %}
        <section class="policy-panel" aria-labelledby="vote-form-heading">
            <h2 id="vote-form-heading">Exprimer votre position</h2>
            {% if saved %}
                <p class="policy-tag voted" role="status">Position enregistrée.</p>
            {% endif %}
            <p>Une seule position active par compte de test et par texte.
                Elle peut être modifiée jusqu'à la clôture ; chaque modification
                reste historisée. Aucune obligation de participation.</p>
            {% if existingVote %}
                <p class="policy-tag voted">Votre dernière position :
                    <strong>{{ existingVote|upper }}</strong>
                </p>
            {% endif %}
            <form method="post" class="policy-vote-form"
                  action="{{ path('policy_vote', {id: measure.id}) }}">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="_from" value="{{ policySection }}">
                <fieldset>
                    <legend>Votre choix</legend>
                    <div class="policy-vote-options">
                        {% for value, label in {pour:'Pour', contre:'Contre', abstention:'Abstention'} %}
                            <label>
                                <input type="radio" name="choice" value="{{ value }}"
                                       {{ existingVote == value ? 'checked' : '' }} required>
                                {{ label }}
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <p>
                    <label for="policy-argument">Votre argumentaire (facultatif)</label>
                    <textarea id="policy-argument" name="argument" rows="4"
                              maxlength="2000"
                              placeholder="Expliquez votre raisonnement, une cause, une conséquence ou une réserve."></textarea>
                </p>
                <p class="small muted">Évitez toute donnée personnelle dans
                    votre argumentaire. L'attribution politique n'est pas affichée
                    tant que la consultation est ouverte.</p>
                <button type="submit">Enregistrer ma position fictive</button>
            </form>
        </section>
    {% endif %}

    <aside class="policy-disclaimer">
        <strong>Échéance de la consultation expérimentale</strong>
        <p>Clôture programmée : {{ measure.closesAt|date('d/m/Y à H:i', 'UTC') }}
            (heure UTC). Les résultats agrégés et la provenance du dossier
            deviennent publics après clôture uniquement.
            Ce bulletin ne modifie aucune loi ni consultation historique.</p>
    </aside>
{% endblock %}
