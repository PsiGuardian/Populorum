{% extends 'base.html.twig' %}
{% import 'partials/macros.html.twig' as ui %}
{% block content %}
    <div class="page-title">
        <div>
            <div class="eyebrow">
                {{ (state.preferences.votingUnit|default('individual'))
                    == 'family'
                    ? 'UNE VOIX PAR FAMILLE FICTIVE'
                    : 'RÈGLES HISTORIQUES · VOIX INDIVIDUELLES' }}
            </div>
            <h1>Les consultations</h1>
            <p>
                Texte, règles et admissibilité figés avant l’ouverture. Aucun
                vote n’a d’effet juridique.
            </p>
        </div>
    </div>
    {{ ui.filter(view, state, q, territory) }}
    {% for consultation in state.consultations %}
        {% if
            (selected == '' or selected == consultation.id)
                and (territory == 'all'
                    or territory == consultation.territoryId)
                and (q == ''
                    or (q|lower) in (consultation.frozen.title|lower)) %}
            {% set tally = consultation.tally %}
            <article
                class="consultation-card"
                data-consultation-id="{{ consultation.id }}"
            >
                <div class="consultation-main">
                    <div class="row-header">
                        {{
                            ui.badge(
                                tally.phase == 'cancelled'
                                    ? 'Consultation annulée · procédure documentée'
                                    : tally.phase == 'expired'
                                        ? 'Échéance atteinte · proclamation en attente'
                                        : tally.phase == 'open'
                                            ? 'Consultation ouverte'
                                            : 'Consultation close',
                                tally.phase == 'open' ? 'green' : 'gray'
                            )
                        }}
                        <span class="small muted">
                            {{ territoryMap[consultation.territoryId].name }} · version
                            figée {{ consultation.version }}
                        </span>
                    </div>
                    <h2>{{ consultation.frozen.title }}</h2>
                    {% if tally.unit == 'family' %}
                        <p class="notice">
                            Chaque personnage peut expliquer son chemin et
                            exprimer un choix. Seul le suffrage des familles
                            détermine l’adoption : une famille compte au maximum
                            une voix, quelle que soit sa taille.
                        </p>
                    {% endif %}
                    <p>
                        {{ consultation.frozen.summary }}
                    </p>
                    <div class="tally">
                        <div
                            class="vote-bar"
                            role="img"
                            aria-label="{{ tally.pour }} pour, {{
                            tally.contre
                            }} contre, {{ tally.abstention }} abstentions"
                        >
                            {% for choice in ['pour', 'contre', 'abstention'] %}
                                <span
                                    class="{{ choice }}"
                                    style="width:{{
                                    tally.total
                                        ? tally[choice] / tally.total * 100
                                        : 0
                                    }}%"
                                >

                                </span>
                            {% endfor %}
                        </div>
                        <div class="vote-counts">
                            <span>
                                <i class="pour"></i>
                                <strong data-count="pour">
                                    {{ tally.pour }}
                                </strong> Pour
                            </span>
                            <span>
                                <i class="contre"></i>
                                <strong data-count="contre">
                                    {{ tally.contre }}
                                </strong> Contre
                            </span>
                            <span>
                                <i class="abstention"></i>
                                <strong data-count="abstention">
                                    {{ tally.abstention }}
                                </strong> Abstention
                            </span>
                        </div>
                        <p
                            class="small muted"
                            data-electoral-summary
                            data-quorum="{{ consultation.rules.quorum }}"
                        >
                            {{ tally.total }} / {{ tally.eligible }}
                            {{ tally.unit == 'family'
                                ? 'familles'
                                : 'personnages' }} ·
                            {{ tally.participation|round }} % · quorum
                            {{ consultation.rules.quorum }} %
                        </p>
                    </div>
                    {% if tally.unit == 'family' %}
                        <p data-individual-summary>
                            Opinions individuelles : {{ tally.individual.pour }} POUR,
                            {{ tally.individual.contre }} CONTRE, {{
                                tally.individual.abstention
                            }} ABSTENTIONS. Ces {{ tally.individual.total }} prises
                            de position ne sont pas {{ tally.individual.total }} voix
                            d’adoption.
                        </p>
                        <details>
                            <summary>
                                Décompte des familles et règle figée
                            </summary>
                            <p>
                                Majorité stricte des POUR et CONTRE exprimés
                                dans chaque famille. Égalité ou seules
                                abstentions : une abstention familiale. Aucun
                                membre participant : famille non participante.
                                Le quorum porte sur les familles admissibles à
                                l’ouverture.
                            </p>
                            <p class="small muted">
                                Le détail ci-dessous correspond au chargement de
                                la page. <a
                                    href="{{
                                    path(
                                        'section',
                                        {
                                            view: 'consultations',
                                            id: consultation.id
                                        }
                                    )
                                    }}"
                                >
                                    Actualiser le détail des familles
                                </a>.
                            </p>
                            {% for familyId, family in tally.families %}
                                <p>
                                    {{
                                        citizenMap[family.members|first].familyLabel|default(
                                            familyId
                                        )
                                    }} · {{ family.members|length }} membre(s) admissible(s),
                                    {{ family.participants }} participant(s) · {{
                                        family.pour
                                    }} POUR / {{ family.contre }} CONTRE / {{
                                        family.abstention
                                    }} abstention(s) → <strong>
                                        {{ family.choice
                                            ? family.choice|upper
                                            : 'NON PARTICIPANTE' }}
                                    </strong> · poids maximal : 1.
                                </p>
                            {% endfor %}
                            {% if tally.individual.unassigned %}
                                <p>
                                    {{ tally.individual.unassigned }} opinion(s) sans
                                    famille admissible figée : consultables, sans
                                    poids d’adoption.
                                </p>
                            {% endif %}
                        </details>
                    {% endif %}
                    {% if tally.phase == 'open' %}
                        <div class="consultation-actions">
                            {% for choice in ['pour', 'contre', 'abstention'] %}
                                {{
                                    ui.action(
                                        'vote.cast',
                                        choice|capitalize,
                                        {
                                            consultationId: consultation.id,
                                            choice: choice
                                        },
                                        'button'
                                    )
                                }}
                            {% endfor %}
                        </div>
                        <p class="small muted">
                            Résultats provisoires. <a
                                href="{{
                                path(
                                    'section',
                                    {
                                        view: 'consultations',
                                        id: consultation.id
                                    }
                                )
                                }}"
                            >
                                Actualiser les résultats
                            </a>.
                        </p>
                    {% elseif tally.phase == 'expired' %}
                        <p class="notice">
                            Le vote est terminé. Les totaux attendent une
                            clôture et une proclamation tracées ; ils ne sont
                            pas encore définitifs.
                        </p>
                    {% else %}
                        {{
                            ui.badge(
                                tally.adopted
                                    ? 'Adoptée dans la simulation'
                                    : 'Non adoptée dans la simulation',
                                tally.adopted ? 'green' : 'gray'
                            )
                        }}
                    {% endif %}
                    <p
                        class="small"
                        data-live-status
                        role="status"
                        aria-live="polite"
                    ></p>
                    <details>
                        <summary>
                            Participations nominatives fictives
                        </summary>
                        {% for vote in state.votes|filter(
                            vote => vote.consultationId == consultation.id
                        ) %}
                            <p>
                                {{ citizenMap[vote.citizenId].name }} — {{
                                    vote.choice
                                }} · {{ vote.history|length }} révision(s){% if
                                    citizenMap[vote.citizenId].mind is defined %}
                                    <a
                                        href="{{
                                        path(
                                            'fictional_character',
                                            {
                                                id: vote.citizenId,
                                                consultation: consultation.id
                                            }
                                        )
                                        }}"
                                    >
                                        Lire les douze réponses et leur
                                        évolution
                                    </a>
                                {% endif %}
                            </p>
                        {% endfor %}
                    </details>
                    <details>
                        <summary>
                            Texte exact soumis au vote
                        </summary>
                        {% for key, label in {
                            cause: 'Cause',
                            consequence: 'Conséquence',
                            solution: 'Solution',
                            justification: 'Justification',
                            indicator: 'Indicateur',
                            risk: 'Risque',
                            reversibility: 'Réversibilité'
                        } %}
                            <h4>{{ label }}</h4>
                            <p>
                                {{ consultation.frozen[key] }}
                            </p>
                        {% endfor %}
                    </details>
                </div>
                <aside class="consultation-rules">
                    <div class="eyebrow">
                        RÈGLES FIGÉES
                    </div>
                    <h4>{{ consultation.rules.majority }}</h4>
                    <p>
                        Abstentions : {{ consultation.rules.abstention }}
                    </p>
                    <p>
                        Une prise de position active par personnage admissible.
                    </p>
                    {% if tally.unit == 'family' %}
                        <p>
                            Une voix d’adoption au maximum par famille.
                        </p>
                    {% endif %}
                    <p>
                        Changement {{ consultation.rules.changeAllowed
                            ? 'autorisé avant clôture'
                            : 'interdit' }}.
                    </p>
                    <p>
                        {{ consultation.opensAt|date('d/m/Y H:i') }} → {{
                            consultation.closesAt|date('d/m/Y H:i')
                        }}
                    </p>
                    <a
                        class="plain"
                        href="{{
                        path(
                            'export',
                            {
                                kind: 'consultation',
                                id: consultation.id
                            }
                        )
                        }}"
                    >
                        Exporter pour un recalcul indépendant ↓
                    </a>
                    {% if consultation.status == 'open' %}
                        {{
                            ui.action(
                                'consultation.close',
                                'Clôturer la simulation',
                                {
                                    consultationId: consultation.id
                                },
                                'plain danger'
                            )
                        }}
                    {% elseif
                        tally.adopted
                            and not state.experiments|filter(
                                experiment => experiment.consultationId
                                    == consultation.id
                            ) %}
                        {{
                            ui.action(
                                'experiment.create',
                                'Définir un protocole',
                                {
                                    consultationId: consultation.id
                                }
                            )
                        }}
                    {% endif %}
                    {% if consultation.status == 'closed' %}{{
                        ui.action(
                            'consultation.review',
                            'Réexaminer un incident de résultat',
                            {
                                consultationId: consultation.id
                            }
                        )
                    }}{% endif %}
                </aside>
            </article>
        {% endif %}
    {% endfor %}
    <div class="notice">
        <p>
            Les résultats visibles peuvent influencer les choix. Ces
            consultations sont fictives et distinctes des élections officielles.
        </p>
    </div>
    <script src="/live-consultations.js" defer></script>
{% endblock %}
