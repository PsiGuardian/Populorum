{% extends 'base.html.twig' %}
{% import 'partials/macros.html.twig' as ui %}
{% block content %}
    <div class="page-title">
        <div>
            <div class="eyebrow">
                DES RÈGLES DISCUTÉES, DES RECOURS OUVERTS
            </div>
            <h1>La gouvernance</h1>
            <p>
                Un rôle technique ou une contribution financière ne donne aucune
                voix supplémentaire.
            </p>
        </div>
        {{
            ui.action(
                'governance.propose',
                'Proposer une évolution +',
                {},
                'button primary'
            )
        }}
    </div>
    <div class="two-columns">
        <section>
            <h2>Évolutions documentées</h2>
            {% for governanceProposal in state.governance %}
                <article class="panel">
                    {{
                        ui.badge(
                            governanceProposal.status == 'reviewed'
                                ? 'Deux avis indépendants'
                                : 'À examiner'
                        )
                    }}
                    <h3>{{ governanceProposal.title }}</h3>
                    <p>
                        {{ governanceProposal.reason }}
                    </p>
                    <p>
                        Risques : {{ governanceProposal.risk }}
                        <br />Retour arrière : {{ governanceProposal.rollback }}
                    </p>
                    <p>
                        {{ governanceProposal.approvals|length }} avis indépendants
                        fictifs.
                    </p>
                    {{
                        ui.action(
                            'governance.approve',
                            'Enregistrer un avis',
                            {
                                governanceId: governanceProposal.id
                            }
                        )
                    }}
                    {% if governanceProposal.status == 'reviewed' %}
                        {{
                            ui.action(
                                'governance.enact',
                                'Appliquer aux prochaines consultations',
                                {
                                    governanceId: governanceProposal.id
                                }
                            )
                        }}
                    {% endif %}
                    <p class="small muted">
                        Ces avis ne modifient pas les règles des consultations
                        existantes.
                    </p>
                </article>
            {% else %}
                <p class="empty">
                    Aucune évolution proposée.
                </p>
            {% endfor %}
        </section>
        <section>
            <h2>Coexistence et recours</h2>
            <div class="panel">
                <p>
                    Un désaccord avec une opinion n’est pas une faute. Les
                    signalements doivent porter sur des actes documentés.
                </p>
                {{ ui.action('moderation.report', 'Ouvrir un dossier fictif') }}
            </div>
            {% for moderationCase in state.cases %}
                <article class="panel">
                    {{ ui.badge(moderationCase.status) }}
                    <h3>{{ moderationCase.reason }}</h3>
                    <p>
                        Objet : {{ moderationCase.objectId }} · aucune suspension
                        automatique.
                    </p>
                    {{
                        ui.action(
                            'moderation.decide',
                            'Instruire',
                            {
                                caseId: moderationCase.id
                            }
                        )
                    }}
                    {{
                        ui.action(
                            'moderation.confirm',
                            'Confirmer en indépendance',
                            {
                                caseId: moderationCase.id
                            }
                        )
                    }}
                    {% for decision in moderationCase.decisions %}
                        <p>
                            {{ decision.rule }} · {{ decision.measure }} · {{
                                decision.days
                            }} jours · {{ decision.status }}
                        </p>
                        <p>
                            {{ decision.facts }} · Preuves : {{
                                decision.evidence
                            }} · {{ decision.reason }}
                        </p>
                    {% endfor %}
                    {{
                        ui.action(
                            'moderation.appeal',
                            'Exercer un recours',
                            {
                                caseId: moderationCase.id
                            },
                            'plain'
                        )
                    }}
                    {% for appeal in state.appeals|filter(
                        appeal => appeal.caseId == moderationCase.id
                    ) %}
                        <p>
                            Recours {{ appeal.status }} : {{ appeal.reason }}
                            {% if appeal.resolution is defined %}{{
                                appeal.resolution.reason
                            }}{% endif %}
                            {{
                                ui.action(
                                    'moderation.resolve',
                                    'Réexaminer le recours',
                                    {
                                        appealId: appeal.id
                                    }
                                )
                            }}
                        </p>
                    {% endfor %}
                </article>
            {% endfor %}
        </section>
    </div>
{% endblock %}
