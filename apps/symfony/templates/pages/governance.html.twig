{% extends 'base.html.twig' %}{% import 'partials/macros.html.twig' as ui %}{% block content %}<div class="page-title"><div><div class="eyebrow">DES RÈGLES DISCUTÉES, DES RECOURS OUVERTS</div><h1>La gouvernance</h1><p>Un rôle technique ou une contribution financière ne donne aucune voix supplémentaire.</p></div>{{ ui.action('governance.propose','Proposer une évolution +',{},'button primary') }}</div><div class="two-columns"><section><h2>Évolutions documentées</h2>{% for g in s.governance %}<article class="panel">{{ ui.badge(g.status == 'reviewed' ? 'Deux avis indépendants' : 'À examiner') }}<h3>{{ g.title }}</h3><p>{{ g.reason }}</p><p>Risques : {{ g.risk }}<br>Retour arrière : {{ g.rollback }}</p><p>{{ g.approvals|length }} avis indépendants fictifs.</p>{{ ui.action('governance.approve','Enregistrer un avis',{governanceId:g.id}) }}<p class="small muted">Ces avis ne modifient pas les règles des consultations existantes.</p></article>{% else %}<p class="empty">Aucune évolution proposée.</p>{% endfor %}</section><section><h2>Coexistence et recours</h2><div class="panel"><p>Un désaccord avec une opinion n’est pas une faute. Les signalements doivent porter sur des actes documentés.</p>{{ ui.action('moderation.report','Ouvrir un dossier fictif') }}</div>{% for c in s.cases %}<article class="panel">{{ ui.badge('Examen en cours') }}<h3>{{ c.reason }}</h3><p>Objet : {{ c.objectId }} · aucune suspension automatique.</p>{{ ui.action('moderation.appeal','Exercer un recours',{caseId:c.id},'plain') }}{% for a in s.appeals|filter(a=>a.caseId == c.id) %}<p>Recours en attente : {{ a.reason }}</p>{% endfor %}</article>{% endfor %}</section></div>{% endblock %}
