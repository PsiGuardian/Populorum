{
  "name": "populorum/demos-kratos-demo",
  "description": "D\u00e9mos Kratos: d\u00e9monstration Symfony et SQLite isol\u00e9e, trois villes et Profiler Shield",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-tokenizer": "*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/yaml": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "omegaguardian/profiler-shield": "dev-dev-1.0.1",
    "doctrine/orm": "^3.5",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "symfony/form": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/security-csrf": "8.1.*"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/PsiGuardian/profiler-shield"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "@php tests/integration.php"
  }
}
