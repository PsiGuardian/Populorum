{
  "name": "populorum/demos-kratos-demo",
  "description": "Démos Kratos: démonstration Symfony et SQLite isolée, trois villes et Profiler Shield",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-tokenizer": "*",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.5",
    "league/commonmark": "^2.8",
    "omegaguardian/profiler-shield": "dev-dev-1.0.1",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/monolog-bundle": "^3.11 || ^4.0",
    "symfony/rate-limiter": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "symfony/yaml": "8.1.*",
    "ext-simplexml": "*",
    "ext-zlib": "*"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/PsiGuardian/profiler-shield"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": [
      "@php tests/integration.php",
      "@php tests/corrections.php",
      "@php tests/requirements-audit.php",
      "@php vendor/bin/phpunit"
    ],
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix",
    "analyse": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.0"
  }
}
