/vendor/
/var/*
!/var/.gitkeep
/.guardian-shield/
/.env.local
/.env.*.local
/auth.json

# Vue JSON développée reproductible ; la fixture compacte sans perte est versionnée.
/data/scenario.json

# National source files are downloadable and must not bloat Git history.
/data/research/decp-sources/
/data/research/decp-backups/
/data/research/public-procurement*.sqlite*
/data/geography/*.sqlite
/data/geography/*.sqlite-wal
/data/geography/*.sqlite-shm
/config/services.yaml.bak

# Complete SSMSI national archives and derived statistics remain local.
/data/research/ssmsi-communes-*.csv.gz
/data/research/ssmsi-national-*.sqlite*
